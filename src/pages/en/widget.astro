---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/reverse-mortgage-calculator/" title="Reverse mortgage calculator" width="100%" height="1300" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the reverse mortgage calculator on your site, free" description="Housing counselors, senior centers, elder law attorneys and personal finance writers can embed the HECM calculator built on the HUD factor table with one iframe line." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Embed the calculator', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed the calculator' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="font-serif text-3xl font-bold text-navy-900 md:text-4xl">Embed the reverse mortgage calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One line of code. When HUD publishes the next limit or a new factor table, the embedded calculator follows.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <p>Terms: keep the credit line under the calculator visible, do not alter the frame, and do not place it next to a lead form or a lender's offer. The frame sets no cookie and sends us nothing about your readers. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
    <h2>HECM amount, costs and first-year limit, line by line</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/reverse-mortgage-calculator/" title="Reverse mortgage calculator" width="100%" height="1300" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
