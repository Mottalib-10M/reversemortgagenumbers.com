---
/** Every topic page (src/content/guides). */
import ContentPage from '../../components/ContentPage.astro';
import { GUIDES } from '../../lib/pages';
import type { GuideDef } from '../../lib/page-types';
export function getStaticPaths() {
  return GUIDES.map((page) => ({ params: { slug: page.slug }, props: { def: page } }));
}
const { def } = Astro.props as { def: GuideDef };
---
<ContentPage page={def} />
